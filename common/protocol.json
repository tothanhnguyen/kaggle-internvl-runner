{
  "dataset": "TN-Mammo",
  "dataset_version": "1.0.0",
  "task": "breast_density_classification",
  "phase": "zero-shot",
  "classes": [
    "A",
    "B",
    "C",
    "D"
  ],
  "view_order": [
    "left_cc",
    "left_mlo",
    "right_cc",
    "right_mlo"
  ],
  "split": {
    "method": "stratified_holdout",
    "seed": 42,
    "train_ratio": 0.6,
    "val_ratio": 0.2,
    "test_ratio": 0.2
  },
  "input_policy": {
    "views_per_case": 4,
    "custom_preprocessing": false,
    "note": "Use official JPEG images and each model's official processor."
  },
  "generation": {
    "do_sample": false,
    "max_new_tokens": 4
  },
  "metrics": [
    "accuracy",
    "macro_f1",
    "macro_precision",
    "macro_recall",
    "confusion_matrix"
  ],
  "invalid_policy": "Unparseable outputs are marked INVALID and are not silently removed."
}